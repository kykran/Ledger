# Copy to .env.local for `vercel dev`, and add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Browser (safe to expose) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_BILLING_ENABLED=false

# --- Server only (never prefix with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_URL=https://trainertally.app

# Trial / paywall (leave off while testing)
REQUIRE_SUBSCRIPTION=false
TRIAL_DAYS=14

# Stripe (phase 2)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_1UKpGyAu4XObXNuOlgi7Rzws   # sandbox $3/month price (live mode gets its own ID)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AUTOMATIC_TAX=false
