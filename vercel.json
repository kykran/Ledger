{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/client.html"
    },
    {
      "source": "/p/:token",
      "destination": "/program.html"
    },
    {
      "source": "/programs",
      "destination": "/programs.html"
    }
  ],
  "functions": {
    "api/cron/hourly.js": {
      "maxDuration": 60
    },
    "api/sync.js": {
      "maxDuration": 60
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/voice.js": {
      "maxDuration": 30
    }
  }
}
